# ==========================================================
# SINGLESTORE
# ==========================================================
 
# MODO LOCAL (tu PC):
# 1) Abrir un PowerShell aparte y dejar vivo el tunel:
#    ssh -L 3307:10.189.1.35:3306 ue01006628@10.16.242.25
# 2) Usar SS_DIRECT_HOST=127.0.0.1 y SS_PORT=3307.
#
# MODO SERVIDOR / DOCKER PRODUCCION:
# - No usar tunel SSH manual.
# - Usar SS_DIRECT_HOST=10.189.1.35 y SS_PORT=3306 si el servidor ve SingleStore.
# - Si existe un balanceador MySQL/SingleStore real, poner SS_USE_BALANCER=true
#   y SS_BALANCER_HOST=<ip_o_dns_del_balanceador>.
#
# IMPORTANTE:
# 10.16.242.25 es el servidor SSH/bastion, no es el host MySQL de SingleStore.
 
# false = usa SS_DIRECT_HOST
# true  = usa SS_BALANCER_HOST si esta definido
SS_USE_BALANCER=false
 
# Local con tunel SSH:
SS_DIRECT_HOST=127.0.0.1
 
# Produccion directa seria:
# SS_DIRECT_HOST=10.189.1.35
 
# Balanceador real MySQL/SingleStore, si aplica:
SS_BALANCER_HOST=
 
# Host efectivo usado por la app. En local debe coincidir con SS_DIRECT_HOST.
SS_HOST=127.0.0.1
SS_PORT=3307
 
# Produccion directa seria:
# SS_HOST=10.189.1.35
# SS_PORT=3306
 
SS_DATABASE=gatekeeper_meta
SS_USER=root
SS_PASSWORD=$q7@S%qc6i3FOH
 
# Filtro para listar bases en el panel Admin.
# Vacio = muestra todas las bases no-sistema.
# Ejemplo: DB_NAME_FILTERS=db_catalogo,catalogo,manual
DB_NAME_FILTERS=CATALOGO
 
# ==========================================================
# HIVE
# ==========================================================
 
HIVE_HOST=10.16.190.21
HIVE_PORT=10000
HIVE_DATABASE=default
 
# ==========================================================
# LDAP / ACTIVE DIRECTORY
# ==========================================================
 
LDAP_SERVER=ldap://austro.grpfin
LDAP_PORT=389
LDAP_DOMAIN=baustro.fin.ec
 
LDAP_BIND_USER=CN=ldap_user,OU=ServiceAccounts,DC=baustro,DC=fin,DC=ec
LDAP_BIND_PASSWORD=TU_PASSWORD
 
# ==========================================================
# APP
# ==========================================================
 
APP_ENV=production
APP_PORT=8501
 
# Admin local temporal para acceso sin LDAP
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=admin123
 
# ==========================================================
# AUDITORÍA
# ==========================================================
 
AUDIT_STORAGE_PATH=/app/audit_storage