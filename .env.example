# ==========================================================
# APP
# ==========================================================
APP_ENV=production
APP_PORT=8501
MAX_FILE_SIZE_MB=50
MAX_ROWS_IN_MEMORY=500000
LOG_LEVEL=INFO

# ==========================================================
# SINGLESTORE
# ==========================================================
# Local con tunel SSH:
#   SS_USE_BALANCER=false
#   SS_DIRECT_HOST=127.0.0.1
#   SS_HOST=127.0.0.1
#   SS_PORT=3307
#
# Servidor / Docker produccion:
#   SS_USE_BALANCER=false
#   SS_DIRECT_HOST=10.189.1.35
#   SS_HOST=10.189.1.35
#   SS_PORT=3306
#
# Balanceador MySQL/SingleStore:
#   SS_USE_BALANCER=true
#   SS_BALANCER_HOST=<ip_o_dns_balanceador>
SS_USE_BALANCER=false
SS_DIRECT_HOST=10.189.1.35
SS_BALANCER_HOST=
SS_HOST=10.189.1.35
SS_PORT=3306
SS_DATABASE=gatekeeper_meta
SS_USER=<usuario_singlestore>
SS_PASSWORD=<password_singlestore>

# Vacio = muestra todas las bases no-sistema.
# Ejemplo: DB_NAME_FILTERS=db_catalogo,catalogo,manual
DB_NAME_FILTERS=CATALOGO

# ==========================================================
# HIVE
# ==========================================================
HIVE_HOST=<host_hive>
HIVE_PORT=10000
HIVE_DATABASE=default
HIVE_USER=<usuario_hive>
HIVE_PASSWORD=<password_hive>

# ==========================================================
# LDAP / ACTIVE DIRECTORY
# ==========================================================
LDAP_AUTH_METHOD=NTLM
LDAP_SERVER=ldap://<host_ldap>
LDAP_PORT=389
LDAP_DOMAIN=<dominio_ntlm>
LDAP_BASE_DN=<base_dn>
LDAP_USE_SSL=false
LDAP_BIND_USER=<usuario_bind_o_dn>
LDAP_BIND_PASSWORD=<password_bind>
LDAP_USERS_OU=<ou_usuarios>
LDAP_GROUPS_OU=<ou_grupos>
LDAP_ADMIN_DN=<dn_admin_ldap>
LDAP_ADMIN_PASSWORD=<password_admin_ldap>
LDAP_REQUIRED_GROUP=

# ==========================================================
# ADMIN LOCAL TEMPORAL
# ==========================================================
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=<password_admin_local>

# ==========================================================
# AUDITORIA
# ==========================================================
AUDIT_STORAGE_PATH=/app/audit_storage

# ==========================================================
# TABLAS METADATA
# ==========================================================
TBL_PROYECTOS=proyectos
TBL_CATALOGOS=catalogos_config
TBL_USUARIOS=usuarios
TBL_PERMISOS=permisos_catalogo
TBL_LOG_AUDITORIA=log_auditoria
