# ------------------------------------------------------------------
# Data Gatekeeper — Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ------------------------------------------------------------------

# Modo demo: true = sin LDAP ni BD reales (para desarrollo)
DEMO_MODE=true

# LDAP / Active Directory
LDAP_SERVER=ldap://ad.baustro.fin.ec
LDAP_PORT=389
LDAP_BASE_DN=DC=baustro,DC=fin,DC=ec
LDAP_DOMAIN=BAUSTRO
LDAP_USE_SSL=false

# SingleStore
SS_HOST=localhost
SS_PORT=3306
SS_USER=admin
SS_PASSWORD=
SS_DATABASE=gatekeeper_meta

# Almacenamiento de auditoría (ruta en el servidor)
AUDIT_STORAGE_PATH=./audit_storage

# Límites
MAX_FILE_SIZE_MB=50
MAX_ROWS_IN_MEMORY=500000
