# ==========================================================
# DATA GATEKEEPER - VARIABLES PARA DOCKER COMPOSE DE PRUEBA
# ==========================================================
#
# Uso recomendado:
#   1. Copiar este archivo a docker/.env
#   2. Levantar el ambiente:
#      docker compose -f docker/docker-compose.prueba.yml up -d --build
#
# Este archivo es solo para entorno local de prueba.
# No usar estas credenciales en produccion.

# ==========================================================
# APP
# ==========================================================

APP_ENV=local
APP_PORT=8501
LOG_LEVEL=INFO

SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=admin123

# ==========================================================
# SINGLESTORE DE PRUEBA
# ==========================================================

SS_USE_BALANCER=false
SS_DIRECT_HOST=singlestore
SS_BALANCER_HOST=
SS_HOST=singlestore
SS_PORT=3306
SS_DATABASE=gatekeeper_meta
SS_USER=root
SS_PASSWORD=gatekeeper123
DB_NAME_FILTERS=

# ==========================================================
# HIVE DE PRUEBA
# ==========================================================

HIVE_HOST=hive
HIVE_PORT=10000
HIVE_DATABASE=default
HIVE_USER=hive
HIVE_PASSWORD=

# ==========================================================
# LDAP / OPENLDAP DE PRUEBA
# ==========================================================
#
# Usuarios cargados desde docker/ldap/01_seed.ldif:
#   vcastro / demo123  -> Publicador
#   admin   / admin123 -> Admin LDAP

LDAP_SERVER=ldap://ldap
LDAP_PORT=389
LDAP_DOMAIN=baustro.fin.ec
LDAP_USE_SSL=false
LDAP_AUTH_METHOD=SIMPLE

LDAP_BASE_DN=dc=baustro,dc=fin,dc=ec
LDAP_USERS_OU=ou=users,dc=baustro,dc=fin,dc=ec
LDAP_GROUPS_OU=ou=groups,dc=baustro,dc=fin,dc=ec
LDAP_ADMIN_DN=cn=admin,dc=baustro,dc=fin,dc=ec
LDAP_ADMIN_PASSWORD=admin
LDAP_BIND_USER=cn=admin,dc=baustro,dc=fin,dc=ec
LDAP_BIND_PASSWORD=admin
LDAP_REQUIRED_GROUP=

# ==========================================================
# TABLAS METADATA
# ==========================================================

TBL_PROYECTOS=proyectos
TBL_CATALOGOS=catalogos_config
TBL_USUARIOS=usuarios
TBL_PERMISOS=permisos_catalogo
TBL_LOG_AUDITORIA=log_auditoria

# ==========================================================
# AUDITORIA / COLD STORAGE
# ==========================================================

AUDIT_STORAGE_PATH=/app/audit_storage
AUDIT_STORAGE_READONLY_AFTER_WRITE=true
AUDIT_STORAGE_DIR_MODE=750
AUDIT_STORAGE_FILE_MODE=440

# ==========================================================
# LIMITES DE CARGA
# ==========================================================

MAX_UPLOAD_SIZE_MB=100
MAX_FILE_SIZE_MB=100
MAX_ROWS_IN_MEMORY=500000

# ==========================================================
# ALERTAS WEBHOOK
# ==========================================================

ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_ON_SUCCESS=false
