# ==========================================================
# DATA GATEKEEPER - VARIABLES DE ENTORNO
# ==========================================================
#
# Copia este archivo como .env para ejecucion local, o como docker/.env
# para el compose de prueba.
#
# No versionar credenciales reales.
#
# Para produccion, el compose espera un archivo externo:
# /opt/configs/data-gatekeeper/.env.prod


# ==========================================================
# 1. APLICACION
# ==========================================================

# Ambiente logico: local, dev, qa, test, production.
APP_ENV=local

# Puerto interno donde corre Streamlit.
APP_PORT=8501

# Nivel de logs: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO


# ==========================================================
# 2. ADMINISTRADOR LOCAL TEMPORAL
# ==========================================================

# Usuario local de emergencia para entrar sin LDAP.
# Usar solo en pruebas o contingencia.
SYSTEM_ADMIN_USERNAME=admin

# Clave del admin local. Cambiar siempre fuera de local.
SYSTEM_ADMIN_PASSWORD=admin123


# ==========================================================
# 3. SINGLESTORE
# ==========================================================

# Si es true, la app usa SS_BALANCER_HOST como host efectivo.
SS_USE_BALANCER=false

# Host directo de SingleStore cuando no se usa balanceador.
SS_DIRECT_HOST=singlestore

# Host del balanceador de SingleStore, si aplica.
SS_BALANCER_HOST=

# Host efectivo de SingleStore.
# En Docker de prueba normalmente es singlestore.
# En servidor real puede ser IP, DNS o balanceador.
SS_HOST=singlestore

# Puerto MySQL/SingleStore.
SS_PORT=3306

# Base administrativa donde viven las tablas de metadata.
SS_DATABASE=gatekeeper_meta

# Usuario de conexion a SingleStore.
SS_USER=root

# Password de conexion a SingleStore.
# En docker-compose.prueba.yml tambien se usa como ROOT_PASSWORD.
SS_PASSWORD=gatekeeper123

# Filtro opcional para mostrar solo ciertas bases en el panel Admin.
# Si esta vacio, muestra todas excepto bases de sistema.
# Ejemplo: DB_NAME_FILTERS=catalogo,manual,datamart
DB_NAME_FILTERS=


# ==========================================================
# 4. HIVE
# ==========================================================

# Activa o desactiva completamente la integracion con Hive.
HIVE_ENABLED=true

# Host de HiveServer2.
HIVE_HOST=hive

# Puerto de HiveServer2.
HIVE_PORT=10000

# Base Hive por defecto.
HIVE_DATABASE=default

# Usuario de conexion a Hive.
HIVE_USER=hive

# Password de Hive si el entorno lo requiere.
HIVE_PASSWORD=


# ==========================================================
# 5. LDAP / ACTIVE DIRECTORY
# ==========================================================
#
# Metodo soportado:
# - LDAPSEARCH: ejecuta el binario del sistema `ldapsearch`
#   usando bind con `usuario@dominio`.

# Host o URL del servidor LDAP/AD.
# Ejemplo AD: austro.grpfin
# Ejemplo Docker prueba: ldap://ldap
LDAP_SERVER=ldap://ldap

# Dominio usado para bind con usuario@dominio.
LDAP_DOMAIN=baustro.fin.ec

# Base DN desde donde se buscan usuarios.
# Ejemplo AD: DC=austro,DC=grpfin
# Ejemplo OpenLDAP: dc=baustro,dc=fin,dc=ec
LDAP_BASE_DN=dc=baustro,dc=fin,dc=ec

# Grupo requerido para permitir ingreso.
# Vacio permite cualquier usuario autenticado.
LDAP_REQUIRED_GROUP=

# Solo LDAPSEARCH: atributo usado para buscar al usuario autenticado.
LDAP_SEARCH_ATTRIBUTE=sAMAccountName

# Solo LDAPSEARCH: nombre o ruta del binario ldapsearch.
LDAPSEARCH_BIN=ldapsearch


# ==========================================================
# 6. TABLAS DE METADATA
# ==========================================================

# Tabla de proyectos logicos.
TBL_PROYECTOS=proyectos

# Tabla de configuracion de catalogos.
TBL_CATALOGOS=catalogos_config

# Tabla de usuarios internos del portal.
TBL_USUARIOS=usuarios

# Tabla de permisos por catalogo.
TBL_PERMISOS=permisos_catalogo

# Tabla de auditoria de cargas.
TBL_LOG_AUDITORIA=log_auditoria


# ==========================================================
# 7. AUDITORIA / COLD STORAGE
# ==========================================================

# Ruta donde se guardan ZIPs auditados.
AUDIT_STORAGE_PATH=/app/audit_storage

# Si true, intenta dejar el ZIP como solo lectura despues de escribirlo.
AUDIT_STORAGE_READONLY_AFTER_WRITE=true

# Permisos Unix para directorios de auditoria.
AUDIT_STORAGE_DIR_MODE=750

# Permisos Unix para archivos ZIP auditados.
AUDIT_STORAGE_FILE_MODE=440


# ==========================================================
# 8. LIMITES DE CARGA Y VALIDACION
# ==========================================================

# Limite general de subida usado como valor base.
MAX_UPLOAD_SIZE_MB=100

# Tamano maximo permitido por archivo.
MAX_FILE_SIZE_MB=100

# Maximo de filas que se mantienen en memoria durante una carga.
MAX_ROWS_IN_MEMORY=500000


# ==========================================================
# 9. ALERTAS WEBHOOK
# ==========================================================

# Activa o desactiva notificaciones por webhook.
ALERTS_ENABLED=false

# URL del webhook operativo.
ALERT_WEBHOOK_URL=

# Si true, tambien alerta cargas exitosas.
# Si false, solo alerta fallos.
ALERT_ON_SUCCESS=false
